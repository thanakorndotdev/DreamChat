# Cloudflare Zero Trust > Networks > Tunnels > Create tunnel (Cloudflared) > copy the token.
# Public hostname in the dashboard must point to: http://app:3000
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Workers AI — when both are set, chat goes to Workers AI instead of Ollama.
# dash.cloudflare.com > AI > Workers AI for the account ID; API token needs Workers AI Read + Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional. Default: @cf/meta/llama-3.1-8b-instruct-fp8 (small, cheap). Better Thai: @cf/google/gemma-4-26b-a4b-it or @cf/aisingapore/gemma-sea-lion-v4-27b-it
CLOUDFLARE_MODEL=
# Optional. Used when CLOUDFLARE_MODEL keeps failing (502/429/capacity). Default: @cf/meta/llama-3.1-8b-instruct-fp8. Set to "none" to disable.
CLOUDFLARE_FALLBACK_MODEL=
