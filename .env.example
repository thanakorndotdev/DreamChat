# PostgreSQL (docker compose starts it as the "db" service). Pick a long random password.
POSTGRES_PASSWORD=
# Optional; defaults to longrak / longrak.
POSTGRES_USER=
POSTGRES_DB=
# For `npm run dev`, put DATABASE_URL in apps/api/.env.local instead, e.g.
# DATABASE_URL=postgres://longrak:password@127.0.0.1:5433/longrak

# Public-site tunnel. The api service is internal only; never give it a hostname.
# Cloudflare Zero Trust > Networks > Tunnels > Create tunnel (Cloudflared) > copy the token.
# Public hostname: longrakchat.com -> http://web:3000
CLOUDFLARE_TUNNEL_TOKEN=

# Separate admin tunnel. Public hostname: admin.longrakchat.com -> http://admin:3000
# Add a Cloudflare Access self-hosted application for admin.longrakchat.com before sharing the URL.
CLOUDFLARE_ADMIN_TUNNEL_TOKEN=

# Cloudflare Workers AI — when both are set, it takes the reply whenever Ollama (OLLAMA_MODEL) is down or busy.
# dash.cloudflare.com > AI > Workers AI for the account ID; API token needs Workers AI Read + Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional. Default: @cf/meta/llama-3.1-8b-instruct-fp8 (small, cheap). Better Thai: @cf/google/gemma-4-26b-a4b-it or @cf/aisingapore/gemma-sea-lion-v4-27b-it
CLOUDFLARE_MODEL=
# Optional. Used when CLOUDFLARE_MODEL keeps failing (502/429/capacity). Default: @cf/meta/llama-3.1-8b-instruct-fp8. Set to "none" to disable.
CLOUDFLARE_FALLBACK_MODEL=

# Long random string shared by the admin app and the api; admin endpoints only answer requests that carry it.
#   openssl rand -hex 32
ADMIN_PROXY_SECRET=

# Admins: sign up normally, then on the server run
#   docker compose --project-directory . -f docker/docker-compose.yml exec api node scripts/make-admin.mjs <username>
# (a name in env could be registered by anyone before you, so admin rights are never granted by name).

# Stripe (memberships and token packs). dashboard.stripe.com > Developers > API keys. Use sk_test_… until you go live.
STRIPE_SECRET_KEY=
# Developers > Webhooks > add endpoint https://<your domain>/api/billing/webhook with the events checkout.session.completed,
# checkout.session.async_payment_succeeded (PromptPay token packs), customer.subscription.created/updated/deleted and
# invoice.paid, then copy its signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Public site URL for Stripe's return links, e.g. https://longrakchat.com
APP_URL=

# Shown on /privacy and /terms (PDPA requires naming the data controller and a contact).
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
