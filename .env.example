# PostgreSQL (docker compose starts it as the "db" service). Pick a long random password.
POSTGRES_PASSWORD=
# Optional; defaults to longrak / longrak.
POSTGRES_USER=
POSTGRES_DB=
# Only for running the app outside docker compose (e.g. npm run dev), e.g.
# DATABASE_URL=postgres://longrak:password@127.0.0.1:5432/longrak
DATABASE_URL=

# Cloudflare Zero Trust > Networks > Tunnels > Create tunnel (Cloudflared) > copy the token.
# Public hostname in the dashboard must point to: http://app:3000
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Workers AI — when both are set, chat goes to Workers AI instead of Ollama.
# dash.cloudflare.com > AI > Workers AI for the account ID; API token needs Workers AI Read + Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional. Default: @cf/meta/llama-3.1-8b-instruct-fp8 (small, cheap). Better Thai: @cf/google/gemma-4-26b-a4b-it or @cf/aisingapore/gemma-sea-lion-v4-27b-it
CLOUDFLARE_MODEL=
# Optional. Used when CLOUDFLARE_MODEL keeps failing (502/429/capacity). Default: @cf/meta/llama-3.1-8b-instruct-fp8. Set to "none" to disable.
CLOUDFLARE_FALLBACK_MODEL=

# Comma-separated usernames that are always admins and can open /admin. They can promote other accounts there.
ADMIN_USERNAMES=

# Stripe (membership billing). dashboard.stripe.com > Developers > API keys. Use sk_test_… until you go live.
STRIPE_SECRET_KEY=
# Developers > Webhooks > add endpoint https://<your domain>/api/billing/webhook, then copy its signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Public site URL for Stripe's return links, e.g. https://longrakchat.com
APP_URL=

# Shown on /privacy and /terms (PDPA requires naming the data controller and a contact).
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
