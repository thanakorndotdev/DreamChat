{
  "name": "longrakchat",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,admin -c blue,magenta,yellow \"npm run dev -w @longrak/api\" \"npm run dev -w @longrak/web\" \"npm run dev -w @longrak/admin\"",
    "build": "npm run build -w @longrak/api && npm run build -w @longrak/web && npm run build -w @longrak/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "make-admin": "node packages/db/scripts/make-admin.mjs",
    "docker:up": "docker compose --project-directory . -f docker/docker-compose.yml --profile tunnel up -d --build",
    "docker:down": "docker compose --project-directory . -f docker/docker-compose.yml --profile tunnel down",
    "docker:logs": "docker compose --project-directory . -f docker/docker-compose.yml logs -f --tail=100",
    "admin:tunnel": "sh scripts/start-admin-tunnel.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.1.0",
    "typescript": "^7.0.2"
  }
}
